# ==============================================================================
# Git Ignore Rules for Jaanch AI
# ==============================================================================

# Python Bytecode, Caches & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/

# Node.js & Dependencies
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production Build Outputs
dist/
build/
.vercel

# Test Coverage
coverage/

# Environment Files (Protect secrets; keep documented examples)
.env*
!.env.example
!.env.test

# Logs & Temporary Files
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db
desktop.ini

# Video Generation Workspace
demo_video/

# Prevent accidental dumps of large binaries or media at repository root
/*.joblib
/*.mp4
/*.ogg
/*.wav
