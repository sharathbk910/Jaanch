# ==========================================
# JAANCH SERVER ENVIRONMENT CONFIGURATION
# ==========================================

# Server runtime mode & networking
NODE_ENV=development
PORT=8080
CLIENT_ORIGINS=http://localhost:5173

# Supabase database & authentication
# (Never use SUPABASE_SERVICE_ROLE_KEY in runtime request handling)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-placeholder

# Salt pepper for SHA-256 entity hashing (required, >= 24 characters)
REPORT_HASH_PEPPER=change-this-to-a-secure-random-pepper-at-least-24-chars-long

# Optional Gemini AI assistance
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Operational feature flags
DEMO_MODE=false
ENABLE_THIRD_PARTY_CHECKS=false

# Third-party intelligence APIs (Optional, requires ENABLE_THIRD_PARTY_CHECKS=true)
SAFE_BROWSING_API_KEY=
CT_LOG_BASE_URL=https://crt.sh
CT_LOG_TIMEOUT_MS=5000
RDAP_BASE_URL=https://rdap.org
RDAP_TIMEOUT_MS=5000
DNS_TIMEOUT_MS=2000

# Listing comparison SSRF parameters
LISTING_FETCH_TIMEOUT_MS=5000
LISTING_MAX_BYTES=1000000

# Rate limits
RATE_LIMIT_ANALYZE_GUEST_PER_HOUR=30
RATE_LIMIT_ANALYZE_USER_PER_HOUR=60
RATE_LIMIT_AI_GUEST_PER_HOUR=10
RATE_LIMIT_AI_USER_PER_HOUR=30
RATE_LIMIT_LISTING_PER_HOUR=10
RATE_LIMIT_REPORTS_PER_DAY=20
RATE_LIMIT_LOOKUP_PER_HOUR=60

# Logging
LOG_LEVEL=info
